{
  "name": "chrondle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bunx convex dev\" \"next dev --turbopack\"",
    "dev:next": "next dev --turbopack",
    "build": "next build",
    "build:do": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit --incremental",
    "type-check:ci": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:unit": "vitest run -c vitest.config.unit.ts",
    "test:unit:watch": "vitest -c vitest.config.unit.ts",
    "test:integration": "vitest run -c vitest.config.integration.ts",
    "test:integration:watch": "vitest -c vitest.config.integration.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:paywall": "playwright test --project=paywall",
    "test:e2e:subscription": "playwright test --project=subscription",
    "test:e2e:all": "playwright test",
    "test-module-system": "node scripts/test-module-system.mjs",
    "bundle-analysis": "ANALYZE=true bun run build",
    "size": "size-limit",
    "ts-prune": "ts-prune --ignore '(used in module)|_generated|config.ts|layout.tsx|page.tsx'",
    "unimported": "unimported",
    "prepare": "husky",
    "clean": "rm -rf .next node_modules/.cache tsconfig.tsbuildinfo",
    "clean:next": "rm -rf .next tsconfig.tsbuildinfo",
    "clean:dev": "bun run clean:next && bun run dev",
    "fresh": "bun run clean && bun install && bun run dev",
    "check-cache": "node scripts/check-cache-age.mjs",
    "assets:favicons": "node scripts/generate-favicons.mjs",
    "predev": "node scripts/check-cache-age.mjs || true",
    "events": "tsx scripts/manage-events.ts",
    "events:audit": "tsx scripts/audit-events.ts",
    "deploy:verify": "node scripts/verify-deployment.mjs",
    "doctor:hosting": "node scripts/verify-hosting-parity.mjs",
    "verify:provider-retirement": "node scripts/check-provider-retirement.mjs",
    "deploy": "convex deploy && bun run deploy:verify",
    "validate-puzzles": "node scripts/check-convex-state.mjs",
    "verify:convex": "node scripts/verify-convex-files.mjs",
    "verify:auth": "node scripts/verify-auth-production.mjs",
    "verify:auth:prod": "node scripts/verify-auth-production.mjs --production",
    "deployment:check": "node scripts/check-deployment-ready.mjs",
    "pre-push": "bun run type-check && bun run verify:convex && bun run verify:provider-retirement",
    "quality": "node scripts/quality-report.mjs",
    "audit:prod": "bun audit --production --audit-level moderate",
    "dagger:local": "./scripts/dagger-local.sh",
    "ci:dagger:lint": "./scripts/dagger-local.sh call quality --check=lint",
    "ci:dagger:type-check": "./scripts/dagger-local.sh call quality --check=type-check",
    "ci:dagger:validation": "./scripts/dagger-local.sh call validation",
    "ci:dagger:docs": "./scripts/dagger-local.sh call docs-link-check",
    "ci:dagger:coverage": "./scripts/dagger-local.sh call test-coverage-artifacts --output=coverage",
    "verify:env": "node scripts/verify-env-config.mjs",
    "verify:env:prod": "node scripts/verify-env-config.mjs production",
    "verify:stripe": "node scripts/verify-stripe-config.mjs",
    "verify:stripe:live": "node scripts/verify-stripe-config.mjs --live",
    "verify:webhook": "node scripts/verify-webhook-redirect.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "evals": "tsx scripts/run-evals.ts",
    "evals:view": "promptfoo view",
    "langfuse:upload": "tsx scripts/upload-langfuse-prompts.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^6.0.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@langfuse/client": "^5.11.0",
    "@langfuse/otel": "^4.6.1",
    "@langfuse/tracing": "^5.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "motion": "^12.43.0",
    "next": "16.3.3",
    "posthog-js": "^1.428.6",
    "posthog-node": "^5.51.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0",
    "stripe": "^20.4.1",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1",
    "serialize-javascript": "7.0.5",
    "brace-expansion": "5.0.5",
    "@isaacs/brace-expansion": "5.0.5",
    "picomatch": "4.0.4",
    "dompurify": "3.4.13",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "hono": ">=4.12.2",
    "esbuild": "^0.25.0",
    "ws": "^8.21.0",
    "postcss": "^8.5.16",
    "protobufjs": "^8.6.5",
    "@protobufjs/utf8": "^1.1.1",
    "@grpc/grpc-js": "^1.14.4",
    "yaml": "^2.9.0",
    "@opentelemetry/core": "^2.9.0",
    "tar-fs": ">=3.1.1",
    "nanoid": "^5.0.9",
    "fast-xml-parser": ">=5.3.6",
    "glob": "^11.1.0",
    "minimatch": ">=10.2.3",
    "basic-ftp": ">=5.2.0",
    "mdast-util-to-hast": ">=13.2.1",
    "qs": ">=6.14.2",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "16.2.11",
    "@playwright/test": "^1.63.0",
    "@rtsao/scc": "^1.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@size-limit/preset-app": "11.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "commander": "^14.0.3",
    "concurrently": "^9.2.4",
    "convex-test": "^0.0.41",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "9.1.7",
    "jsdom": "27.0.0",
    "lightningcss": "^1.33.0",
    "lint-staged": "16.1.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "promptfoo": "^0.120.27",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.0",
    "size-limit": "11.2.0",
    "tailwindcss": "^4.3.3",
    "ts-prune": "0.10.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "1.3.4",
    "typescript": "^5.9.3",
    "unimported": "1.31.1",
    "vitest": "^3.2.7"
  },
  "trustedDependencies": [
    "@clerk/shared",
    "@playwright/browser-chromium",
    "@swc/core",
    "core-js",
    "esbuild",
    "onnxruntime-node",
    "protobufjs",
    "sharp",
    "unrs-resolver"
  ]
}
